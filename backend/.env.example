DATABASE_URL=postgresql://dev:devpass@localhost:5432/welfare_facilities_db
DEBUG=true
API_TITLE=Welfare Facilities DB
API_VERSION=0.1.0
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
HOST=0.0.0.0
PORT=8000

# Data import paths (required for scheduled imports)
FACILITY_CSV_PATH=/path/to/facility_data.csv
FINANCIAL_CSV_PATH=/path/to/financial_data.csv

# Slack webhook URL (optional, for pipeline notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Backup configuration
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=7
DB_HOST=db
DB_PORT=5432
DB_NAME=welfare_facilities_db
DB_USER=dev
DB_PASSWORD=devpass

# Monitoring
GRAFANA_ADMIN_PASSWORD=admin
